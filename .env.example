# Copy to .env and replace all placeholder values.
# Use alphanumeric characters for DB_PASSWORD and RABBITMQ_PASSWORD.
DB_PASSWORD=ReplaceWithRandomAlphanumericPassword123456
# Optional: set this to a Neon PostgreSQL connection URL to use Neon instead of the local database.
# Use sslmode=require and URL-encode special characters in the username or password.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-webhook-secret-at-least-32-characters
MIDTRANS_SERVER_KEY=replace-with-your-midtrans-sandbox-server-key
FRONTEND_URL=http://localhost:5173
OAUTH_CLIENT_ID=crowdfunding-gateway
OAUTH_CLIENT_SECRET=replace-with-a-random-oauth-secret-at-least-32-characters
RABBITMQ_USER=crowdfunding
RABBITMQ_PASSWORD=ReplaceWithRandomAlphanumericPassword123456
CORS_ALLOWED_ORIGINS=http://localhost:5173
